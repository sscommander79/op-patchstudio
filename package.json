{
  "name": "op-patchstudio",
  "private": true,
  "version": "0.16.0",
  "type": "module",
  "description": "Free and open source preset creator for OP synthesizers. Upload samples, edit waveforms, adjust settings, and generate patches instantly.",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sscommander79/op-patchstudio.git"
  },
  "homepage": "https://op-patch.studio",
  "bugs": {
    "url": "https://github.com/sscommander79/op-patchstudio/issues"
  },
  "author": "Joseph Holland",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:studio": "vite --host 127.0.0.1 --port 5191 --strictPort",
    "build": "tsc -b && vite build && npm run verify:pwa",
    "verify:pwa": "node scripts/verify-pwa-build.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:production": "PLAYWRIGHT_PRODUCTION=1 playwright test",
    "test:e2e:storage-integration": "playwright test --config=playwright.storage-integration.config.ts",
    "test:e2e:recording": "PLAYWRIGHT_PRODUCTION=1 PLAYWRIGHT_FAKE_AUDIO_FILE=/tmp/opstudio-ci-fake-audio.wav playwright test --config=playwright.recording-device.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:studio-contract": "playwright test tests/e2e/studio-design-contract.spec.ts tests/e2e/studio-shell.spec.ts tests/e2e/drum-pad-access.spec.ts --project=chromium",
    "test:e2e:dev-origin": "playwright test --config=playwright.dev-origin.config.ts",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "verify:studio": "npm run test:e2e:studio-contract && npm run test:e2e:dev-origin && npm run test:visual",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "pre-commit": "npm run check",
    "generate-icons": "node scripts/generate-pwa-icons.js",
    "generate-icons-advanced": "node scripts/generate-pwa-icons-advanced.js",
    "generate-favicons": "node scripts/generate-all-favicons.js",
    "update-version": "node scripts/update-version.js",
    "update-changelog": "node scripts/update-changelog.js"
  },
  "dependencies": {
    "@carbon/react": "^1.85.1",
    "@carbon/styles": "^1.84.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "jszip": "^3.10.1",
    "react": "^19.1.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.1.0",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "4.1.6",
    "@vitest/ui": "4.1.6",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "fake-indexeddb": "^6.2.5",
    "globals": "16.5.0",
    "jsdom": "^25.0.1",
    "sass": "1.104.0",
    "semver": "7.8.5",
    "sharp": "0.35.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.6",
    "webmidi": "3.1.16",
    "workbox-window": "7.3.0"
  },
  "overrides": {
    "vite-plugin-pwa": {
      "workbox-build": "7.3.0",
      "workbox-window": "7.3.0"
    }
  }
}
