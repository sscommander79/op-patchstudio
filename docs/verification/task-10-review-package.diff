+function makeBuffer(length: number, sampleRate = 44_100, amplitude = 0.25): AudioBuffer {
+  const buffer = new AudioContext().createBuffer(1, length, sampleRate);
+  buffer.getChannelData(0).fill(amplitude);
+  return buffer;
