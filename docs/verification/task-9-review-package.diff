+import { useEffect, useRef, useState } from 'react';
+import { registerSW } from 'virtual:pwa-register';
+
+export function PWAUpdatePrompt() {
+  const [notice, setNotice] = useState<'update' | 'offline' | null>(null);
+  const updateServiceWorker = useRef<ReturnType<typeof registerSW> | null>(null);
+
+  useEffect(() => {
+    updateServiceWorker.current = registerSW({
+      onNeedRefresh: () => setNotice('update'),
+      onOfflineReady: () => setNotice('offline'),
+    });
+  }, []);
+
+  if (!notice) return null;
+
+  return (
+    <aside className="studio-pwa-notice" role="status" aria-live="polite">
+      <p>
+        {notice === 'update'
+          ? 'An update is ready. Save or back up your project before updating.'
+          : 'The studio is ready to work offline.'}
+      </p>
+      <div className="studio-pwa-notice__actions">
+        {notice === 'update' && (
+          <button type="button" onClick={() => void updateServiceWorker.current?.(true)}>
+            Update now
+          </button>
+        )}
+        <button type="button" onClick={() => setNotice(null)}>Later</button>
+      </div>
+    </aside>
+  );
+}
