+/* Keep the current and immediately previous app precaches as bounded
+ * activation/reload protection. Updates cannot activate while another app
+ * window is open. CacheStorage preserves creation order, so a third build
+ * retires the oldest app precache while unrelated origin caches are untouched. */
+self.addEventListener('message', (event) => {
+  if (event.data?.type !== 'OPSTUDIO_ACTIVATE_IF_SOLE_CLIENT') return;
+  event.waitUntil((async () => {
+    const openWindows = await self.clients.matchAll({ type: 'window', includeUncontrolled: true });
+    if (openWindows.length <= 1) {
+      await self.skipWaiting();
+      return;
+    }
+    event.source?.postMessage({ type: 'OPSTUDIO_UPDATE_BLOCKED_OPEN_TABS' });
+  })());
+});
+
+self.addEventListener('activate', (event) => {
+  event.waitUntil((async () => {
+    const appPrecaches = (await caches.keys()).filter((name) =>
+      name.startsWith('op-patchstudio-') && name.includes('-precache-'));
+    const expired = appPrecaches.slice(0, -2);
+    await Promise.all(expired.map((name) => caches.delete(name)));
+  })());
+});
