+import { act, renderHook } from '@testing-library/react';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { useWebMidi } from '../../hooks/useWebMidi';
+
+const midi=vi.hoisted(()=>({
+  supported:true,enabled:false,inputs:[],outputs:[],
+  enable:vi.fn(async()=>{throw new DOMException('permission denied','NotAllowedError');}),
+  addListener:vi.fn(),removeListener:vi.fn(),
+}));
+vi.mock('webmidi',()=>({WebMidi:midi,Input:class{},Output:class{}}));
+
+describe('useWebMidi initialization ownership',()=>{
+  beforeEach(()=>{midi.enabled=false;midi.enable.mockClear();});
+
+  it('allows one automatic permission attempt across hook instances and preserves explicit retry',async()=>{
+    const first=renderHook(()=>useWebMidi()),second=renderHook(()=>useWebMidi());
+    await act(async()=>{expect(await first.result.current.initialize({automatic:true})).toBe(false);});
+    await act(async()=>{expect(await second.result.current.initialize({automatic:true})).toBe(false);});
+    expect(midi.enable).toHaveBeenCalledOnce();
+    expect(first.result.current.state.error).toBe('permission denied');
+
+    await act(async()=>{expect(await second.result.current.initialize()).toBe(false);});
+    expect(midi.enable).toHaveBeenCalledTimes(2);
+    first.unmount();second.unmount();
+  });
+});
--- before/src/test/utils/pwaCacheLifecycle.test.ts
+++ after/src/test/utils/pwaCacheLifecycle.test.ts
@@ -0,0 +1,48 @@
+import { readFileSync } from 'node:fs';
+import { describe, expect, it, vi } from 'vitest';
+
+type WorkerListener = (event: {
+  data?: {type?:string};
+  source?: {postMessage:(message:unknown)=>void};
+  waitUntil:(promise:Promise<unknown>)=>void;
+}) => void;
+
+function loadLifecycle(windowCount:number,cacheNames:string[]) {
+  const listeners=new Map<string,WorkerListener>();
+  const deleted:string[]=[];
+  const skipWaiting=vi.fn(async()=>undefined),postMessage=vi.fn();
+  const worker={
+    clients:{matchAll:vi.fn(async()=>Array.from({length:windowCount},()=>({})))},
+    skipWaiting,
+    addEventListener:(type:string,listener:WorkerListener)=>listeners.set(type,listener),
+  };
+  const cacheStorage={keys:vi.fn(async()=>cacheNames),delete:vi.fn(async(name:string)=>{deleted.push(name);return true;})};
+  const source=readFileSync(`${process.cwd()}/public/pwa-cache-lifecycle.js`,'utf8');
+  Function('self','caches',source)(worker,cacheStorage);
+  const dispatch=async(type:string,data?:{type:string})=>{
+    let work:Promise<unknown>=Promise.resolve();
+    listeners.get(type)?.({data,source:{postMessage},waitUntil:promise=>{work=Promise.resolve(promise);}});
+    await work;
+  };
+  return {dispatch,deleted,postMessage,skipWaiting};
+}
+
+describe('PWA cache lifecycle',()=>{
+  it('keeps an update waiting while another app window is open',async()=>{
+    const worker=loadLifecycle(2,[]);
+    await worker.dispatch('message',{type:'OPSTUDIO_ACTIVATE_IF_SOLE_CLIENT'});
+    expect(worker.skipWaiting).not.toHaveBeenCalled();
+    expect(worker.postMessage).toHaveBeenCalledWith({type:'OPSTUDIO_UPDATE_BLOCKED_OPEN_TABS'});
+  });
+
+  it('activates for a sole app window and retains only two app precaches',async()=>{
+    const worker=loadLifecycle(1,[
+      'op-patchstudio-A-precache-v2-scope','unrelated-cache',
+      'op-patchstudio-B-precache-v2-scope','op-patchstudio-C-precache-v2-scope',
+    ]);
+    await worker.dispatch('message',{type:'OPSTUDIO_ACTIVATE_IF_SOLE_CLIENT'});
+    await worker.dispatch('activate');
+    expect(worker.skipWaiting).toHaveBeenCalledOnce();
+    expect(worker.deleted).toEqual(['op-patchstudio-A-precache-v2-scope']);
+  });
+});
